{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GST REG-06 Extraction Schema v1",
  "type": "object",
  "required": ["gstin", "legal_name", "trade_name", "registration_date"],
  "properties": {
    "gstin": { "type": "string", "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][A-Z0-9]Z[A-Z0-9]$" },
    "legal_name": { "type": "string" },
    "trade_name": { "type": "string" },
    "registration_date": { "type": "string", "format": "date" }
  }
}
