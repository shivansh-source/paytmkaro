{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aadhaar (masked) Extraction Schema v1",
  "type": "object",
  "required": [
    "name",
    "aadhaar_last4"
  ],
  "properties": {
    "name": {
      "maxLength": 100,
      "minLength": 2,
      "pattern": "^[A-Za-z\\u0900-\\u0DFF][A-Za-z\\u0900-\\u0DFF .'-]*$",
      "type": "string"
    },
    "dob": {
      "format": "date",
      "type": "string"
    },
    "year_of_birth": {
      "maximum": 2100,
      "minimum": 1900,
      "type": "integer"
    },
    "gender": {
      "enum": [
        "male",
        "female",
        "transgender"
      ],
      "type": "string"
    },
    "aadhaar_last4": {
      "pattern": "^[0-9]{4}$",
      "type": "string"
    },
    "address": {
      "maxLength": 400,
      "minLength": 8,
      "type": "string"
    },
    "pincode": {
      "pattern": "^[1-9][0-9]{5}$",
      "type": "string"
    }
  }
}
