{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAN Card Extraction Schema v1",
  "type": "object",
  "required": ["name", "pan", "dob"],
  "properties": {
    "name": { "type": "string" },
    "pan": { "type": "string", "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]$" },
    "dob": { "type": "string", "format": "date" }
  }
}
