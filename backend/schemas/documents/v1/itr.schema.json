{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ITR Extraction Schema v1",
  "type": "object",
  "required": [
    "pan",
    "name",
    "assessment_year",
    "total_income"
  ],
  "properties": {
    "pan": {
      "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]$",
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "minLength": 2,
      "pattern": "^[A-Za-z\\u0900-\\u0DFF][A-Za-z\\u0900-\\u0DFF .'-]*$",
      "type": "string"
    },
    "assessment_year": {
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "type": "string"
    },
    "form_type": {
      "pattern": "^ITR-[1-7]$",
      "type": "string"
    },
    "acknowledgement_number": {
      "pattern": "^[0-9]{15}$",
      "type": "string"
    },
    "filing_date": {
      "format": "date",
      "type": "string"
    },
    "gross_total_income": {
      "minimum": 0,
      "type": "number"
    },
    "total_income": {
      "minimum": 0,
      "type": "number"
    },
    "tax_payable": {
      "minimum": 0,
      "type": "number"
    },
    "business_turnover": {
      "minimum": 0,
      "type": "number"
    }
  }
}
