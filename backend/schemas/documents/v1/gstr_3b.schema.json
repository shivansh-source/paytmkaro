{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GSTR-3B Extraction Schema v1",
  "type": "object",
  "required": [
    "gstin",
    "period_from",
    "period_to"
  ],
  "properties": {
    "gstin": {
      "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$",
      "type": "string"
    },
    "legal_name": {
      "maxLength": 160,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9\\u0900-\\u0DFF][A-Za-z0-9\\u0900-\\u0DFF .,'&()/-]*$",
      "type": "string"
    },
    "financial_year": {
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "type": "string"
    },
    "period_from": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
      "type": "string"
    },
    "period_to": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
      "type": "string"
    },
    "months_filed": {
      "minimum": 0,
      "type": "integer"
    },
    "total_taxable_outward_value": {
      "minimum": 0,
      "type": "number"
    },
    "total_tax": {
      "minimum": 0,
      "type": "number"
    },
    "periods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "period",
          "taxable_outward_value"
        ],
        "properties": {
          "period": {
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
            "type": "string"
          },
          "taxable_outward_value": {
            "minimum": 0,
            "type": "number"
          },
          "igst": {
            "minimum": 0,
            "type": "number"
          },
          "cgst": {
            "minimum": 0,
            "type": "number"
          },
          "sgst": {
            "minimum": 0,
            "type": "number"
          },
          "cess": {
            "minimum": 0,
            "type": "number"
          },
          "source": {
            "enum": [
              "text_layer",
              "ocr",
              "vlm"
            ],
            "type": "string"
          },
          "page_index": {
            "type": "integer"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          }
        }
      }
    }
  }
}
