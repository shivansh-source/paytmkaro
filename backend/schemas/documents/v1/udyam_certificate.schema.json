{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Udyam Registration Certificate Extraction Schema v1",
  "type": "object",
  "required": [
    "udyam_number",
    "enterprise_name",
    "enterprise_type"
  ],
  "properties": {
    "udyam_number": {
      "pattern": "^UDYAM-[A-Z]{2}-[0-9]{2}-[0-9]{7}$",
      "type": "string"
    },
    "pan": {
      "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]$",
      "type": "string"
    },
    "enterprise_name": {
      "maxLength": 160,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9\\u0900-\\u0DFF][A-Za-z0-9\\u0900-\\u0DFF .,'&()/-]*$",
      "type": "string"
    },
    "enterprise_type": {
      "enum": [
        "micro",
        "small",
        "medium"
      ],
      "type": "string"
    },
    "organisation_type": {
      "enum": [
        "aop",
        "foreign_company",
        "government",
        "huf",
        "llp",
        "opc",
        "partnership",
        "proprietorship",
        "public_ltd",
        "pvt_ltd",
        "society",
        "trust",
        "unlimited_company"
      ],
      "type": "string"
    },
    "date_of_incorporation": {
      "format": "date",
      "type": "string"
    },
    "date_of_commencement": {
      "format": "date",
      "type": "string"
    },
    "registration_date": {
      "format": "date",
      "type": "string"
    },
    "nic_codes": {
      "items": {
        "$ref": "#/$defs/NicCode"
      },
      "type": "array"
    },
    "major_activity": {
      "enum": [
        "manufacturing",
        "services",
        "trading"
      ],
      "type": "string"
    },
    "address": {
      "maxLength": 400,
      "minLength": 8,
      "type": "string"
    },
    "state": {
      "maxLength": 300,
      "minLength": 2,
      "type": "string"
    },
    "pincode": {
      "pattern": "^[1-9][0-9]{5}$",
      "type": "string"
    }
  }
}
