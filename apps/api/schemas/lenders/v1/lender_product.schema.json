{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreditSetu Lender Product Criteria v1",
  "type": "object",
  "required": ["products"],
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lender",
          "product",
          "ticket_size",
          "tenure_months",
          "min_business_vintage_months",
          "min_annual_turnover",
          "min_bureau_score",
          "max_foir",
          "max_bounces_6m",
          "gst_required",
          "allowed_constitutions",
          "excluded_sectors",
          "collateral",
          "scheme",
          "pricing"
        ],
        "properties": {
          "lender": { "type": "string" },
          "product": { "type": "string" },
          "ticket_size": {
            "type": "object",
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "integer", "minimum": 1 },
              "max": { "type": "integer", "minimum": 1 }
            }
          },
          "tenure_months": {
            "type": "object",
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "integer", "minimum": 1 },
              "max": { "type": "integer", "minimum": 1 }
            }
          },
          "min_business_vintage_months": { "type": "integer", "minimum": 0 },
          "min_annual_turnover": { "type": "integer", "minimum": 0 },
          "min_bureau_score": { "type": "integer", "minimum": 300, "maximum": 900 },
          "max_foir": { "type": "number", "minimum": 0, "maximum": 1 },
          "max_bounces_6m": { "type": "integer", "minimum": 0 },
          "gst_required": { "type": "boolean" },
          "allowed_constitutions": { "type": "array", "items": { "type": "string" } },
          "excluded_sectors": { "type": "array", "items": { "type": "string" } },
          "collateral": { "type": "string" },
          "scheme": { "type": "string" },
          "pricing": {
            "type": "object",
            "required": ["apr_range", "processing_fee_pct"],
            "properties": {
              "apr_range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number" }
              },
              "processing_fee_pct": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
