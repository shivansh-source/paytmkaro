        "message": {
          "title": "Message",
          "type": "string"
        },
        "document_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Document Ids",
          "type": "array"
        },
        "fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
