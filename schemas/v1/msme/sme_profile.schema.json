        "bounces_6m": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced_int_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "existing_emi_monthly": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced_float_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "foir": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced_float_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gst_turnover_12m": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced_float_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
