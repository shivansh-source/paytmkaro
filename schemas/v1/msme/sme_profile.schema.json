    "Address": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "district": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "District"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "pincode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pincode"
        }
      },
      "required": [
        "text"
      ],
      "title": "Address",
      "type": "object"
    },
    "BBox": {
      "additionalProperties": false,
      "description": "Where on the page a value was read. Coordinates are fractions of page width/height.",
      "properties": {
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "x0": {
          "maximum": 1,
          "minimum": 0,
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "maximum": 1,
          "minimum": 0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "page",
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BBox",
      "type": "object"
    },
    "BureauScore": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maximum": 900,
          "minimum": 300,
          "title": "Value",
          "type": "integer"
        },
        "source": {
          "enum": [
            "mock",
            "self_declared",
            "bureau"
          ],
          "title": "Source",
          "type": "string"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        }
      },
      "required": [
        "value",
        "source"
      ],
      "title": "BureauScore",
      "type": "object"
    },
    "CashflowMetrics": {
      "additionalProperties": false,
      "description": "Deterministic metrics from bank statements and GSTR-3B. None = not computable yet.",
      "properties": {
        "months_analyzed": {
          "minimum": 0,
