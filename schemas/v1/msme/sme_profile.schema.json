        "gst_vs_bank_ratio": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced_float_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "months_analyzed"
      ],
      "title": "CashflowMetrics",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "description": "One ✓ / ⚠ / ✗ result with a plain-language message for the SME.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
