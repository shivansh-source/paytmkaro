{
  "$defs": {
    "BBox": {
      "additionalProperties": false,
      "description": "Where on the page a value was read. Coordinates are fractions of page width/height.",
      "properties": {
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "x0": {
          "maximum": 1,
          "minimum": 0,
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "maximum": 1,
          "minimum": 0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "page",
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BBox",
      "type": "object"
    },
    "Extracted_date_": {
      "properties": {
        "value": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Text"
        },
        "user_confirmed": {
          "default": false,
          "title": "User Confirmed",
          "type": "boolean"
        },
        "needs_review": {
          "readOnly": true,
          "title": "Needs Review",
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "confidence",
        "source",
        "needs_review"
      ],
      "title": "Extracted[date]",
      "type": "object"
    },
    "Extracted_str_": {
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Text"
        },
        "user_confirmed": {
          "default": false,
          "title": "User Confirmed",
          "type": "boolean"
        },
        "needs_review": {
          "readOnly": true,
          "title": "Needs Review",
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "confidence",
        "source",
        "needs_review"
      ],
      "title": "Extracted[str]",
      "type": "object"
    },
    "Source": {
      "description": "Who produced a value.",
      "enum": [
        "parser",
        "ocr",
        "vlm",
        "user",
        "system"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "pan_card",
      "default": "pan_card",
      "title": "Document Type",
      "type": "string"
    },
    "pan_number": {
      "$ref": "#/$defs/Extracted_str_"
    },
    "name": {
      "$ref": "#/$defs/Extracted_str_"
    },
    "father_name": {
      "anyOf": [
        {
          "$ref": "#/$defs/Extracted_str_"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dob": {
      "$ref": "#/$defs/Extracted_date_"
    }
  },
  "required": [
    "pan_number",
    "name",
    "dob"
  ],
  "title": "PanCard",
  "type": "object",
  "$id": "creditsetu/msme/v1/documents/pan_card"
}
