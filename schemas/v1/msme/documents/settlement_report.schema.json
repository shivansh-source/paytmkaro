        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Text"
        },
        "user_confirmed": {
          "default": false,
          "title": "User Confirmed",
          "type": "boolean"
        },
        "needs_review": {
          "readOnly": true,
          "title": "Needs Review",
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "confidence",
        "source",
        "needs_review"
